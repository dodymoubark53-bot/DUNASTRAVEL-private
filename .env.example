# ========================================
# Dunas Travel Frontend - Environment Variables
# ========================================
# Copy this file to .env.production or .env.local and fill in the values.
# When deploying to Vercel, add these keys in the Vercel Dashboard -> Project Settings -> Environment Variables.

# --- API Configuration ---
# The URL pointing to your backend API. For local development, this is usually http://localhost:5000/api
# For production (Vercel), replace with your deployed backend URL.
VITE_API_URL=https://dunastravel-backend.vercel.app/api

# --- Stripe Integration ---
# Your public key from the Stripe Dashboard (Developers -> API keys)
VITE_STRIPE_PUBLIC_KEY="pk_live_your_public_stripe_key_here"
